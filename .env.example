# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# CUSTOM FIREBASE DATABASE & SECRETS
# ==========================================
# If you have your own Firebase project / Firestore database, you can provide it
# either as a full JSON string or as individual variables:

# Option 1: Full JSON string (as exported from Firebase Console)
# VITE_FIREBASE_CONFIG='{"apiKey":"AIzaSy...","projectId":"your-project","firestoreDatabaseId":"(default)","authDomain":"your-project.firebaseapp.com","appId":"1:...:web:..."}'

# Option 2: Individual variables
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
# VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
# ==========================================
# ADMINISTRATOR ACCOUNT CREDENTIALS
# ==========================================
# Set your master administrator login credentials here.
# When entering these credentials on the login page (/login),
# the system grants full ADMIN privileges and APPROVED status.
VITE_ADMIN_EMAIL="admin@florify.internal"
VITE_ADMIN_PASSWORD="YourAdminSecurePassword123!"
# Optional username alias (e.g. 'admin')
VITE_ADMIN_USERNAME="admin"
