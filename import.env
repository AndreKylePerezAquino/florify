# ==============================================================================
# Florify Shuttle Climate Monitor - Vercel Environment Variables
# ==============================================================================
# Instructions for Vercel:
# 1. Open your Vercel Project Dashboard.
# 2. Go to Settings -> Environment Variables.
# 3. Click "Import .env" and select or paste the contents of this file.
#    (Or via Vercel CLI: `vercel env import Import.env`)
# 4. Select Production, Preview, and Development environments.
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Master Administrator Credentials
# ------------------------------------------------------------------------------
